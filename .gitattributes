# Force cookies.txt to LF — prevents CRLF breaking yt-dlp on Linux servers
backend/cookies.txt text eol=lf

# Frontend/backend source files — LF always
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf

# True binary files
*.png binary
*.jpg binary
*.ico binary
*.webp binary
